    "# Plain request; no key required for this request \n",
    "import requests \n",
    "res = requests.get( \"https://api.goldprice.dev/v1/prices\", params={\"symbol\": \"XAU-USD-SPOT\"}, timeout= 10 ) \n",
    "res.raise_for_status() \n",
    "price = res.json()[\"symbols\"][0] \n",
    "print(price[\"price\"]) # \"4826.40\""
